{
  "name": "@capire/docs",
  "version": "2026.6.1",
  "description": "Capire on VitePress",
  "type": "module",
  "scripts": {
    "start": "npm run docs:dev",
    "setup": "npm ci",
    "docs:dev": "vitepress dev .",
    "docs:build": "npm run types:generate && vitepress build .",
    "docs:preview": "vitepress preview .",
    "lint": "eslint .",
    "test": "npm run test:types && node .github/etc/blc --public",
    "test:types": "node --test types/*.test.js",
    "types:generate": "npm run test:types && node types/update-types.js",
    "types:generate:local": "npm run test:types && node types/update-types.js --local"
  },
  "author": "SAP SE (https://www.sap.com)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "capire/docs",
  "homepage": "https://cap.cloud.sap/",
  "devDependencies": {
    "@cap-js/cds-typer": "^0",
    "@cap-js/cds-types": "^0",
    "@cap-js/sqlite": ">=2",
    "@mdit/plugin-dl": ">=0.22.2",
    "@sap/cds": ">=9",
    "@shikijs/monaco": "^4",
    "@shikijs/vitepress-twoslash": "^4",
    "@sqlite.org/sqlite-wasm": "latest",
    "@types/adm-zip": ">=0.5.0",
    "@types/express": "latest",
    "@typescript-eslint/parser": "^8.0.0",
    "adm-zip": "^0.6.0",
    "express": "^5",
    "fflate": "^0.8.2",
    "globals": "^17.4.0",
    "htmlparser2": "^12",
    "monaco-editor": "^0",
    "patch-package": "^8.0.1",
    "sass": "^1.62.1",
    "sanitize-html": "2.18.2",
    "tar": "7.5.23",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "vite-plugin-cds": "^0.3.1",
    "vitepress": "2.0.0-alpha.21"
  }
}
